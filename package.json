    "backend": ".\\venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000",
    "build": "npm --prefix frontend run build",
    "frontend": "npm --prefix frontend run dev",
    "test": ".\\venv\\Scripts\\python.exe -m pytest"
  }
}
