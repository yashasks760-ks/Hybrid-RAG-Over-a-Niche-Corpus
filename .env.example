# -------------------------------------------------------------
# College AI Knowledge Assistant - Environment Configuration
# -------------------------------------------------------------

# Application Environment (development | production)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# Allowed CORS Origins (comma-separated)
# In local development: http://localhost:5173,http://localhost:3000
# In production on Render: append your Vercel URL (e.g. https://your-frontend.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage & Limits
# In local development: data/documents
# In production on Render with Persistent Disk: mount point path (e.g. /var/data/documents or data/documents)
DOCUMENT_STORAGE_DIR=data/documents
MAX_UPLOAD_SIZE_MB=15

# Vector Database (Qdrant)
# For local persistent development: leave QDRANT_URL empty to use local embedded disk storage
# For Render with Persistent Disk: mount point path (e.g. /var/data/qdrant_storage or data/qdrant_storage)
# For Qdrant Cloud / External Cluster: https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_STORAGE_DIR=data/qdrant_storage
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=college_knowledge_assistant

# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Embedding Model (FastEmbed ONNX - default: BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval & Fusion Parameters
DEFAULT_TOP_K=5
RRF_K=60
SIMILARITY_THRESHOLD=0.35

# LLM Provider Configuration
# Supported providers: gemini, groq, openai, anthropic, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Optional Live Web Search Configuration
# Set WEB_SEARCH_ENABLED=true and provide TAVILY_API_KEY to enable live internet search
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
