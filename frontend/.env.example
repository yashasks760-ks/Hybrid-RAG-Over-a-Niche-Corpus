# College AI Knowledge Assistant - Frontend Environment Configuration

# Local Development:
# Leave empty or set to /api to route through Vite's dev proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=/api

# Production Deployment (Vercel Project Settings -> Environment Variables):
# Point to your deployed Render backend URL (with or without /api):
# VITE_API_BASE_URL=https://your-render-service.onrender.com
