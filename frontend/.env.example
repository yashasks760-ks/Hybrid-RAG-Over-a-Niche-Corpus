# College AI Knowledge Assistant - Frontend Environment Configuration

# Base URL for API requests.
# In local development using the Vite dev proxy, leave as '/api'.
# In standalone production deployment (e.g. Vercel, Netlify, Cloudflare Pages),
# set this to your hosted backend URL, for example:
# VITE_API_BASE_URL=https://your-fastapi-backend.onrender.com/api
VITE_API_BASE_URL=/api
